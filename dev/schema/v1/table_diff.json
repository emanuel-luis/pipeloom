    "Samples": {
      "description": "Up to `SAMPLE_ROWS` rows each, in key order. Columns tagged `sensitive` read `***`.",
      "properties": {
        "partial": {
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "title": "Partial",
          "type": "array"
        },
        "source_only": {
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "title": "Source Only",
          "type": "array"
        },
        "target_only": {
          "items": {
            "additionalProperties": true,
