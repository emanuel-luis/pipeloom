        }
      },
      "required": [
        "relation",
        "rows"
      ],
      "title": "Side",
      "type": "object"
    },
    "TypeChange": {
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "source": {
          "title": "Source",
          "type": "string"
        },
        "target": {
          "title": "Target",
          "type": "string"
        }
      },
      "required": [
        "name",
        "source",
        "target"
