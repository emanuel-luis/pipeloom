          "type": "array"
        }
      },
      "required": [
        "source_only",
        "target_only",
        "partial"
      ],
      "title": "Samples",
      "type": "object"
    },
    "SchemaDiff": {
      "description": "Columns by name, case-sensitive. Order and nullability are ignored.",
