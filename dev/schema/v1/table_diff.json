      ],
      "title": "ColumnType",
      "type": "object"
    },
    "Counts": {
      "properties": {
        "duplicate_keys": {
          "$ref": "#/$defs/PerSide"
        },
        "matched": {
          "title": "Matched",
          "type": "integer"
        },
        "null_keys": {
          "$ref": "#/$defs/PerSide"
        },
        "partial": {
          "title": "Partial",
          "type": "integer"
        },
        "source_only": {
          "title": "Source Only",
          "type": "integer"
        },
        "target_only": {
          "title": "Target Only",
