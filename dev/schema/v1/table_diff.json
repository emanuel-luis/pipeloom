          "type": "array"
        },
        "type_changed": {
          "items": {
            "$ref": "#/$defs/TypeChange"
          },
          "title": "Type Changed",
          "type": "array"
        }
      },
      "required": [
        "added",
        "removed",
        "type_changed"
      ],
      "title": "SchemaDiff",
      "type": "object"
    },
    "Side": {
      "properties": {
        "relation": {
          "title": "Relation",
          "type": "string"
        },
        "rows": {
          "title": "Rows",
