  "$id": "https://emanuel-luis.github.io/pipeloom/latest/schema/v1/table_diff.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "A keyed comparison of one model's relation in a reference and a target.",
  "properties": {
    "columns": {
      "items": {
        "$ref": "#/$defs/ColumnDiff"
      },
      "title": "Columns",
      "type": "array"
    },
    "counts": {
      "$ref": "#/$defs/Counts"
    },
    "differences": {
      "title": "Differences",
      "type": "boolean"
    },
    "key": {
      "items": {
        "type": "string"
      },
      "title": "Key",
      "type": "array"
    },
    "model": {
      "title": "Model",
      "type": "string"
    },
    "samples": {
      "anyOf": [
        {
          "$ref": "#/$defs/Samples"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "schema": {
      "const": "pipeloom.table_diff/1",
      "description": "Schema name and version."
    },
    "schema_diff": {
      "$ref": "#/$defs/SchemaDiff"
    },
    "source": {
      "$ref": "#/$defs/Side"
    },
    "target": {
      "$ref": "#/$defs/Side"
    }
  },
  "required": [
    "schema",
    "model",
    "key",
    "source",
    "target",
    "differences",
    "schema_diff",
    "counts",
    "columns"
  ],
  "title": "pipeloom table diff",
  "type": "object"
}
