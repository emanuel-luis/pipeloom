# Copy to .env (never commit it) and fill in the two placeholders.
# Airflow reads this connection for the tpch_databricks DAG.
# host: your workspace URL, password: a personal access token.
#
# AIRFLOW_CONN_DATABRICKS_DEFAULT='{"conn_type": "databricks", "host": "https://<your-workspace-host>", "password": "<your-personal-access-token>"}'
