# PipeloomDag in WATCHER mode: one producer task runs the whole selection, one watcher per unit
# reads its unit file, finalize waits for the producer and every leaf. Illustrates section 13
# (ADR-0048) of docs/architecture.md.
...@_style
(** -> **)[*].style.font-size: 14

direction: right

producer: "Producer\ntask" {class: process}
store: "Shared\nartifacts root" {class: store}
w1: "stg_orders\nwatcher" {class: process}
w2: "fct_orders\nwatcher" {class: process}
fin: "finalize" {class: process}

producer -> store: unit files
store -> w1 {class: meta}
store -> w2 {class: meta}
w1 -> w2
w2 -> fin
producer -> fin
