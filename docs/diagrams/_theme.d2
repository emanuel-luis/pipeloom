# Light theme, imported by _style.d2. `make diagrams` renders every diagram twice: with this file
# (<name>.light.svg) and with _theme-dark.d2 copied over it (<name>.dark.svg). Each SVG carries one
# theme only, so the docs pick the file that matches the site's palette toggle, not the OS.
# Built-in theme 0 (Neutral default), recolored to the GitHub light palette of the docs site.
vars: {
  d2-config: {
    layout-engine: elk
    theme-id: 0
    pad: 24
    theme-overrides: {
      N1: "#1F2328"
      N2: "#59636E"
      N3: "#818B98"
      N4: "#D1D9E0"
      N5: "#D3F5EF"
      N6: "#EFF2F5"
      N7: "#FFFFFF"
      B1: "#57606A"
      B2: "#57606A"
      B3: "#EADCFF"
      B4: "#F6F8FA"
      B5: "#DDF4FF"
      B6: "#DDF4FF"
      AA2: "#0969DA"
      AA4: "#DAFBE1"
      AA5: "#DAFBE1"
      AB4: "#FFF1C7"
      AB5: "#FFF1C7"
    }
  }
}
