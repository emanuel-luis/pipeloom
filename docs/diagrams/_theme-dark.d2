# Dark theme: `make diagrams` copies this file over _theme.d2 to render <name>.dark.svg.
# Built-in theme 200 (Dark Mauve), recolored to the GitHub dark palette of the docs site (slate).
vars: {
  d2-config: {
    layout-engine: elk
    theme-id: 200
    pad: 24
    theme-overrides: {
      N1: "#E6EDF3"
      N2: "#9198A1"
      N3: "#656C76"
      N4: "#3D444D"
      N5: "#0E3533"
      N6: "#212830"
      N7: "#0D1117"
      B1: "#9198A1"
      B2: "#9198A1"
      B3: "#33245C"
      B4: "#151B23"
      B5: "#0F2D4A"
      B6: "#0F2D4A"
      AA2: "#4493F8"
      AA4: "#11321F"
      AA5: "#11321F"
      AB4: "#3A2C0B"
      AB5: "#3A2C0B"
    }
  }
}
