# Shared style, imported first by every diagram: `...@_style`. Not rendered on its own.
#
# Colors come from _theme.d2 (light) or _theme-dark.d2 (dark); see the Makefile. Explicit colors
# (style.fill: "#...") would be the same in both files, so no class sets a fill. Each kind picks a
# shape instead and D2 fills it with a theme color code that the theme file recolors.
#   process  rectangle  B6 (B5 inside a container)  blue
#   source   page       AB4 / AB5                   amber
#   store    cylinder   AA4 / AA5                   green
#   serving  hexagon    N5                          teal
#   actor    person     B3                          purple
#   external cloud      N7 (the background)         dashed outline
#   check    rectangle  transparent, dashed accent  contracts and tests
# Containers use B4. Strokes and edges use B1/B2, text N1/N2.
#
# Rules: no title, legend or error codes in the image (the page has the caption and the tables),
# labels of 4 words or fewer, about 10 nodes, `direction: right` for flows, under ~1,300 px wide.
# Fonts: 16 nodes, 14 edge labels, 18 container headings. Globs in an import do not reach the
# importer, so each diagram starts with `...@_style` and then `(** -> **)[*].style.font-size: 14`.
...@_theme

classes: {
  process: {shape: rectangle; style.font-size: 16}
  source: {shape: page; style.font-size: 16}
  store: {shape: cylinder; style.font-size: 16}
  serving: {shape: hexagon; style.font-size: 16}
  actor: {shape: person; style.font-size: 16}
  external: {
    shape: cloud
    style: {stroke-dash: 4; font-size: 16}
  }
  check: {
    shape: rectangle
    style: {
      fill: transparent
      stroke: "#BC4C00"
      stroke-dash: 3
      stroke-width: 2
      font-size: 16
    }
  }
  # Edges: solid for data, `meta` dashed for metadata, control and reads that move no data.
  meta: {style: {stroke-dash: 4; font-size: 14}}

  # Container: label top-left, read as a heading. ELK can still route an edge through it.
  group: {label.near: top-left; style: {font-size: 18; bold: true}}
}

