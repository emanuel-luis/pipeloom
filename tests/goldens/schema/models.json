{
  "$defs": {
    "AcceptedValuesCheck": {
      "additionalProperties": false,
      "properties": {
        "column": {
          "title": "Column",
          "type": "string"
        },
        "values": {
          "items": {},
          "title": "Values",
          "type": "array"
        }
      },
      "required": [
        "column",
        "values"
      ],
      "title": "AcceptedValuesCheck",
      "type": "object"
    },
    "CheckConfig": {
      "additionalProperties": false,
      "properties": {
        "accepted_values": {
          "anyOf": [
            {
              "$ref": "#/$defs/AcceptedValuesCheck"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "freshness": {
          "anyOf": [
            {
              "$ref": "#/$defs/FreshnessCheck"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "not_null": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Not Null"
        },
        "range": {
          "anyOf": [
            {
              "$ref": "#/$defs/RangeCheck"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "regex": {
          "anyOf": [
            {
              "$ref": "#/$defs/RegexCheck"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "row_count": {
          "anyOf": [
            {
              "$ref": "#/$defs/RowCountCheck"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "unique": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unique"
        }
      },
      "title": "CheckConfig",
      "type": "object"
    },
    "DeletesConfig": {
      "additionalProperties": false,
      "properties": {
        "column": {
          "description": "Column that marks a deleted row.",
          "title": "Column",
          "type": "string"
        },
        "mode": {
          "default": "hard",
          "description": "Remove the row, or keep it flagged.",
          "enum": [
            "hard",
            "soft"
          ],
          "title": "Mode",
          "type": "string"
        },
        "value": {
          "default": true,
          "description": "Value of the column that means deleted.",
          "title": "Value"
        }
      },
      "required": [
        "column"
      ],
      "title": "DeletesConfig",
      "type": "object"
    },
    "ExpectationConfig": {
      "additionalProperties": false,
      "properties": {
        "check": {
          "anyOf": [
            {
              "$ref": "#/$defs/CheckConfig"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "A portable check."
        },
        "expr": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "An engine-dialect predicate.",
          "title": "Expr"
        },
        "name": {
          "description": "Name shown in results.",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
          "title": "Name",
          "type": "string"
        },
        "on_violation": {
          "default": "fail",
          "description": "What happens to rows or runs that violate it.",
          "enum": [
            "warn",
            "drop",
            "fail"
          ],
          "title": "On Violation",
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "title": "ExpectationConfig",
      "type": "object"
    },
    "FreshnessCheck": {
      "additionalProperties": false,
      "properties": {
        "column": {
          "title": "Column",
          "type": "string"
        },
        "max_age": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "pattern": "^(?=.)(?:\\d+d)?(?:\\d+h)?(?:\\d+m)?(?:\\d+s)?$|^\\d+$|^\\$\\{.+\\}$",
              "type": "string"
            }
          ],
          "title": "Max Age"
        }
      },
      "required": [
        "column",
        "max_age"
      ],
      "title": "FreshnessCheck",
      "type": "object"
    },
    "IncrementalConfig": {
      "additionalProperties": false,
      "properties": {
        "column": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Column compared with the watermark.",
          "title": "Column"
        },
        "input": {
          "description": "Alias of the input that is filtered.",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
          "title": "Input",
          "type": "string"
        },
        "lookback": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "pattern": "^(?=.)(?:\\d+d)?(?:\\d+h)?(?:\\d+m)?(?:\\d+s)?$|^\\d+$|^\\$\\{.+\\}$",
              "type": "string"
            }
          ],
          "default": 0,
          "description": "Reprocess this much before the watermark.",
          "title": "Lookback"
        },
        "watermark_source": {
          "default": "state",
          "description": "Where the watermark is read from.",
          "enum": [
            "state",
            "target"
          ],
          "title": "Watermark Source",
          "type": "string"
        }
      },
      "required": [
        "input"
      ],
      "title": "IncrementalConfig",
      "type": "object"
    },
    "InputConfig": {
      "additionalProperties": false,
      "properties": {
        "ref": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Name of another model.",
          "title": "Ref"
        },
        "source": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Name of a declared source.",
          "title": "Source"
        }
      },
      "title": "InputConfig",
      "type": "object"
    },
    "ModelConfig": {
      "additionalProperties": false,
      "description": "One model.",
      "properties": {
        "catalog": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Catalog of the target relation; wins over the naming strategy's catalog.",
          "title": "Catalog"
        },
        "cluster_by": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Clustering columns.",
          "title": "Cluster By"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "What the model holds.",
          "title": "Description"
        },
        "expectations": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/ExpectationConfig"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Data quality expectations.",
          "title": "Expectations"
        },
        "frame_api": {
          "anyOf": [
            {
              "enum": [
                "native",
                "narwhals"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Frame type passed to Python bodies.",
          "title": "Frame Api"
        },
        "incremental": {
          "anyOf": [
            {
              "$ref": "#/$defs/IncrementalConfig"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Incremental processing."
        },
        "inputs": {
          "description": "Local aliases bound to refs or sources.",
          "patternProperties": {
            "^[A-Za-z_][A-Za-z0-9_]*$": {
              "$ref": "#/$defs/InputConfig"
            }
          },
          "title": "Inputs",
          "type": "object"
        },
        "materialized": {
          "anyOf": [
            {
              "enum": [
                "table",
                "incremental",
                "view",
                "ephemeral",
                "intermediate"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "How the model is stored.",
          "title": "Materialized"
        },
        "meta": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Free-form metadata.",
          "title": "Meta"
        },
        "name": {
          "description": "Unique model name.",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
          "title": "Name",
          "type": "string"
        },
        "partition_by": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Partition columns.",
          "title": "Partition By"
        },
        "python": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z_][\\w.]*:[A-Za-z_]\\w*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Python body as `module:function`.",
          "title": "Python"
        },
        "quality": {
          "anyOf": [
            {
              "$ref": "#/$defs/QualityConfig"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Quarantine settings."
        },
        "retries": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "pattern": "^\\$\\{.+\\}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Retries after a failure.",
          "title": "Retries"
        },
        "retry_delay": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "pattern": "^(?=.)(?:\\d+d)?(?:\\d+h)?(?:\\d+m)?(?:\\d+s)?$|^\\d+$|^\\$\\{.+\\}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Base delay between retries.",
          "title": "Retry Delay"
        },
        "retry_on": {
          "anyOf": [
            {
              "enum": [
                "transient",
                "any"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Which failures are retried.",
          "title": "Retry On"
        },
        "schema": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Schema (namespace) of the target relation.",
          "title": "Schema"
        },
        "sql": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "SQL body.",
          "title": "Sql"
        },
        "tags": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Tags used by selectors.",
          "title": "Tags"
        },
        "timeout": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "pattern": "^(?=.)(?:\\d+d)?(?:\\d+h)?(?:\\d+m)?(?:\\d+s)?$|^\\d+$|^\\$\\{.+\\}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Time limit per attempt.",
          "title": "Timeout"
        },
        "write": {
          "anyOf": [
            {
              "$ref": "#/$defs/WriteConfig"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Write behaviour."
        }
      },
      "required": [
        "name"
      ],
      "title": "ModelConfig",
      "type": "object"
    },
    "QualityConfig": {
      "additionalProperties": false,
      "properties": {
        "max_drop_ratio": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "pattern": "^\\$\\{.+\\}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Fail the unit when more than this share of rows is dropped.",
          "title": "Max Drop Ratio"
        },
        "quarantine": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "pattern": "^\\$\\{.+\\}$",
              "type": "string"
            }
          ],
          "default": false,
          "description": "Write dropped rows to a quarantine table.",
          "title": "Quarantine"
        }
      },
      "title": "QualityConfig",
      "type": "object"
    },
    "RangeCheck": {
      "additionalProperties": false,
      "properties": {
        "column": {
          "title": "Column",
          "type": "string"
        },
        "max": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^\\$\\{.+\\}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max"
        },
        "min": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^\\$\\{.+\\}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Min"
        }
      },
      "required": [
        "column"
      ],
      "title": "RangeCheck",
      "type": "object"
    },
    "RegexCheck": {
      "additionalProperties": false,
      "properties": {
        "column": {
          "title": "Column",
          "type": "string"
        },
        "pattern": {
          "title": "Pattern",
          "type": "string"
        }
      },
      "required": [
        "column",
        "pattern"
      ],
      "title": "RegexCheck",
      "type": "object"
    },
    "RowCountCheck": {
      "additionalProperties": false,
      "properties": {
        "max": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "pattern": "^\\$\\{.+\\}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max"
        },
        "min": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "pattern": "^\\$\\{.+\\}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Min"
        }
      },
      "title": "RowCountCheck",
      "type": "object"
    },
    "SourceConfig": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "What the source holds.",
          "title": "Description"
        },
        "format": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "File or table format.",
          "title": "Format"
        },
        "location": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Path or URI of the data.",
          "title": "Location"
        },
        "meta": {
          "additionalProperties": true,
          "description": "Free-form metadata.",
          "title": "Meta",
          "type": "object"
        },
        "name": {
          "description": "Unique source name.",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
          "title": "Name",
          "type": "string"
        },
        "options": {
          "additionalProperties": true,
          "description": "Reader options.",
          "title": "Options",
          "type": "object"
        },
        "table": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Table name in the catalog.",
          "title": "Table"
        },
        "tags": {
          "description": "Tags used by selectors.",
          "items": {
            "type": "string"
          },
          "title": "Tags",
          "type": "array"
        }
      },
      "required": [
        "name"
      ],
      "title": "SourceConfig",
      "type": "object"
    },
    "WriteConfig": {
      "additionalProperties": false,
      "properties": {
        "deletes": {
          "anyOf": [
            {
              "$ref": "#/$defs/DeletesConfig"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "How deleted rows are recognised and applied."
        },
        "on_schema_change": {
          "default": "fail",
          "description": "Policy when the output schema differs from the target.",
          "enum": [
            "fail",
            "ignore",
            "append_new_columns",
            "sync_all_columns"
          ],
          "title": "On Schema Change",
          "type": "string"
        },
        "options": {
          "additionalProperties": true,
          "description": "Engine-specific write options.",
          "title": "Options",
          "type": "object"
        },
        "strategy": {
          "anyOf": [
            {
              "enum": [
                "append",
                "overwrite",
                "replace_partitions",
                "merge",
                "scd2"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "How rows reach the target.",
          "title": "Strategy"
        },
        "table_properties": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Properties set on the target table.",
          "title": "Table Properties",
          "type": "object"
        },
        "tracked_columns": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Columns whose change opens a new scd2 row; default all.",
          "title": "Tracked Columns"
        },
        "unique_key": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Columns that identify a row (merge and scd2).",
          "title": "Unique Key"
        },
        "update_condition": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Extra condition for updating a matched row (merge).",
          "title": "Update Condition"
        }
      },
      "title": "WriteConfig",
      "type": "object"
    }
  },
  "$id": "https://emanuel-luis.github.io/pipeloom/latest/schema/v1/models.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "A `*.yml` file under model_paths.",
  "properties": {
    "models": {
      "items": {
        "$ref": "#/$defs/ModelConfig"
      },
      "title": "Models",
      "type": "array"
    },
    "sources": {
      "items": {
        "$ref": "#/$defs/SourceConfig"
      },
      "title": "Sources",
      "type": "array"
    }
  },
  "title": "pipeloom model file",
  "type": "object"
}
